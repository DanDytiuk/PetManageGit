<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PetManage.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PetManage"
    xmlns:views="clr-namespace:PetManage.View"
    Title="PetManage">

    <ShellContent
        Title="Главная страница"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    
    <ShellContent
        Title="Настройки"
        ContentTemplate="{DataTemplate views:SettingsPage}"
        Route="SettingsPage" />

    <ShellContent
        Title="Еда"
        ContentTemplate="{DataTemplate views:FoodPage}"
        Route="FoodPage"/>
    
    <ShellContent
        Title="Финансы"
        ContentTemplate="{DataTemplate views:FinancePage}"
        Route="FinancePage"/>

    <ShellContent
        Title="Игры"
        ContentTemplate="{DataTemplate views:GamesPage}"
        Route="GamesPage"/>

    <ShellContent
        Title="Здоровье"
        ContentTemplate="{DataTemplate views:HealthPage}"
        Route="HealthPage"/>

</Shell>
