<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PetManage.View.AddInfoFoodPage"
             Title="Добавление данных о еде">
    <Grid RowDefinitions="7*, 86*, 7*">

        <!--#region Профиль -->
        <Grid Grid.Row="0"
              Padding="10"
              ColumnDefinitions="*,*,*,Auto"
              ColumnSpacing="10">

            <Label Grid.Column="0"
                   Text="Аврора"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"/>

            <Label Grid.Column="1"
                   Text="Кошка"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"/>

            <Label Grid.Column="2"
                   Text="Метис"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"/>

            <Button Grid.Column="3"
                    ImageSource="iconupdown.png"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="20"
                    VerticalOptions="Center"/>
        </Grid>
        <!--#endregion-->

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15"
                                 Spacing="20">

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Наименование корма"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Picker Grid.Column="1"
                                ItemsSource="{Binding FoodNamesPicker}"
                                MinimumWidthRequest="150"
                                MaximumWidthRequest="200"
                                SelectedItem="{Binding SelectedFood}"/>

                    </Grid>
                    
                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*, Auto">

                        <Label Grid.Column="0"
                               Text="Вес корма (г)"
                               VerticalOptions="Center"
                               VerticalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Entry Grid.Column="1"
                               MinimumWidthRequest="150"
                               MaximumWidthRequest="250"
                               Text="{Binding SelectedWeight}"
                               Keyboard="Numeric"/>

                    </Grid>
                    
                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*, Auto">

                        <Label Grid.Column="0"
                               Text="Заметки"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Entry Grid.Column="1"
                               MinimumWidthRequest="150"
                               MaximumWidthRequest="250"
                               Text="{Binding SelectedNotes}"
                               Keyboard="Chat"/>

                    </Grid>

                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*, Auto">

                        <Label Grid.Column="0"
                               Text="Тип аппетита"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Picker Grid.Column="1"
                                MinimumWidthRequest="150"
                                MaximumWidthRequest="250"
                                ItemsSource="{Binding TypeOfAppetitePicker}"
                                SelectedItem="{Binding SelectedAppetite}"/>

                    </Grid>

                </Border>
                
            </VerticalStackLayout>
            
        </ScrollView>

        <!--#region Кнопки S/C -->
        <Grid Grid.Row="2"
              ColumnDefinitions="4.5*, 1*, 4.5*">

            <Button ImageSource="iconfloppydisk.png"
                    BackgroundColor="SpringGreen"
                    FontSize="17"
                    Text="Сохранить"
                    Grid.Column="0"
                    HorizontalOptions="Center"
                    BorderColor="Black"
                    BorderWidth="1"
                    WidthRequest="175"
                    HeightRequest="50"
                    CornerRadius="25"
                    Command="{Binding SaveInfoFoodCommand}"/>

            <Button ImageSource="iconcancelbutton.png"
                    BackgroundColor="LightSalmon"
                    FontSize="17"
                    Text="Отмена"
                    Grid.Column="2"
                    HorizontalOptions="Center"
                    BorderColor="Black"
                    BorderWidth="1"
                    WidthRequest="175"
                    HeightRequest="50"
                    CornerRadius="25"
                    Command="{Binding CancelCommand}"/>

        </Grid>
        <!--#endregion-->

    </Grid>
</ContentPage>