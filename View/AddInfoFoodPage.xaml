<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PetManage.View.AddInfoFoodPage"
             Title="Добавление данных о еде">
    <Grid RowDefinitions="7*, 86*, 7*">

        <!--#region Профиль -->
        <Grid Grid.Row="0"
              Padding="10"
              ColumnDefinitions="*,*,*,Auto"
              ColumnSpacing="10">

            <Label Grid.Column="0"
                   Text="Аврора"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"/>

            <Label Grid.Column="1"
                   Text="Кошка"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"/>

            <Label Grid.Column="2"
                   Text="Метис"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"/>

            <Button Grid.Column="3"
                    ImageSource="iconupdown.png"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="20"
                    VerticalOptions="Center"/>
        </Grid>
        <!--#endregion-->

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15"
                                 Spacing="20">

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Наименование корма"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Picker Grid.Column="1"
                                ItemsSource="{Binding CatFoodPicker}"
                                MinimumWidthRequest="150"
                                MaximumWidthRequest="250"/>

                    </Grid>
                    
                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*, Auto">

                        <Label Grid.Column="0"
                               Text="Вес корма"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Entry Grid.Column="1"
                               MinimumWidthRequest="150"
                               MaximumWidthRequest="250"
                               Text="{Binding SelectedWeight}"
                               Keyboard="Numeric"/>

                    </Grid>
                    
                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*, Auto">

                        <Label Grid.Column="0"
                               Text="Заметки (не обязательно)"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Entry Grid.Column="1"
                               MinimumWidthRequest="150"
                               MaximumWidthRequest="250"
                               Text="{Binding SelectedWeight}"
                               Keyboard="Numeric"/>

                    </Grid>

                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*, Auto">

                        <Label Grid.Column="0"
                               Text="Тип аппетита"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Picker Grid.Column="1"
                                MinimumWidthRequest="150"
                                MaximumWidthRequest="250"
                                ItemsSource="{Binding TypeOfAppetitePicker}"/>

                    </Grid>

                </Border>

            </VerticalStackLayout>
            
        </ScrollView>

    </Grid>
</ContentPage>