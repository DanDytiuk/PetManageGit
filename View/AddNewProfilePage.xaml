<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PetManage.View.AddNewProfilePage"
             Title="Создание профиля">
    <Grid RowDefinitions="93*, 7*">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Padding="15"
                                 Spacing="20">

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Напишите имя питомца"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Entry Grid.Column="1"
                               Text="{Binding NewNamePet}"
                               MinimumWidthRequest="150"
                               MaximumWidthRequest="250"/>

                    </Grid>

                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Выберите тип питомца"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Picker Grid.Column="1"
                                ItemsSource="{Binding AnimalTypes}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                SelectedItem="{Binding NewAnimalPet}"
                                MinimumWidthRequest="150"
                                MaximumWidthRequest="250"/>

                    </Grid>

                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Выберите породу питомца"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Picker Grid.Column="1"
                                ItemsSource="{Binding BreedTypes}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                SelectedItem="{Binding NewBreedPet}"
                                MinimumWidthRequest="150"
                                MaximumWidthRequest="250"/>

                    </Grid>

                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Выберите гендер питомца"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Picker Grid.Column="1"
                                ItemsSource="{Binding GenderTypes}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                SelectedItem="{Binding NewGenderPet}"
                                MinimumWidthRequest="150"
                                MaximumWidthRequest="250"/>

                    </Grid>

                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Введите вес питомца"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Entry Grid.Column="1"
                               Text="{Binding NewWeightPet}"
                               MinimumWidthRequest="150"
                               MaximumWidthRequest="250"/>

                    </Grid>

                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Введите дату рождения питомца"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <DatePicker Grid.Column="1"
                                    Date="{Binding NewBirthPet}"
                                    MinimumDate="{Binding MinDate}"
                                    MaximumDate="{Binding MaxDate}"
                                    Format="D"/>

                    </Grid>

                </Border>

                <Border StrokeThickness="1"
                        Padding="15"
                        Margin="0,5"
                        Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Введите заметки о питомце"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start"
                               MinimumWidthRequest="100"
                               MaximumWidthRequest="250"/>

                        <Entry Grid.Column="1"
                               Text="{Binding NotesPet}"
                               Keyboard="Text"
                               MinimumWidthRequest="150"
                               MaximumWidthRequest="250"/>

                    </Grid>

                </Border>

                

            </VerticalStackLayout>
            
        </ScrollView>

        <!--#region Кнопки S/C -->
        <Grid Grid.Row="2"
              ColumnDefinitions="4.5*, 1*, 4.5*">

            <Button ImageSource="iconfloppydisk.png"
                    BackgroundColor="SpringGreen"
                    FontSize="17"
                    Text="Сохранить"
                    Grid.Column="0"
                    HorizontalOptions="Center"
                    BorderColor="Black"
                    BorderWidth="1"
                    WidthRequest="175"
                    HeightRequest="50"
                    CornerRadius="25"
                    Command="{Binding SaveNewProfileCommand}"/>

            <Button ImageSource="iconcancelbutton.png"
                    BackgroundColor="LightSalmon"
                    FontSize="17"
                    Text="Отмена"
                    Grid.Column="2"
                    HorizontalOptions="Center"
                    BorderColor="Black"
                    BorderWidth="1"
                    WidthRequest="175"
                    HeightRequest="50"
                    CornerRadius="25"
                    Command="{Binding CancelCommand}"/>

        </Grid>
        <!--#endregion-->

    </Grid>
</ContentPage>